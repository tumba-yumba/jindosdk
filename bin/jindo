bin=`which $0`
bin=`dirname ${bin}`
bin=`cd "$bin"; pwd`

function print_usage(){
  echo "Usage: jindo [COMMAND | CLASSNAME]"
  echo "  CLASSNAME            run the class named CLASSNAME"
  echo " or"
  echo "  where COMMAND is one of:"
  echo "  fs                         run Jindo fs shell."
  echo "  admin                      run Jindo admin shell."
  echo ""
  echo "Most commands print help when invoked w/o parameters."
}

if [ $# = 0 ]; then
  print_usage
  exit
fi

COMMAND=$1
SUBCOMMAND=$2
case $COMMAND in
  # usage flags
  --help|-help|-h)
    print_usage
    exit
    ;;

  #core commands
  *)
    # the core commands
    if [[ "$COMMAND" = "distcp" ]] ; then
        CLASS="com.aliyun.jindodata.distcp.DistCpMain"
    elif [[ "$COMMAND" = "distjob" ]] ; then
        CLASS="com.aliyun.jindodata.distjob.tool.DistJobToolMain"
    else
        exec jindo-util "$@"
        exit 0
    fi

    shift

    which hadoop >/dev/null 2>&1
    if [[ $? -ne 0 ]]; then
      export CLASSPATH=$CLASSPATH:$bin/../*:$bin/../lib/*:$bin/*:$bin/../ext/*:$bin/../tools/*:/opt/apps/extra-jars/hadoop-lzo-0.4.21-SNAPSHOT.jar
    else
      export CLASSPATH=`hadoop classpath`:$CLASSPATH:$bin/../*:$bin/../lib/*:$bin/*:$bin/../ext/*:$bin/../tools/*:/opt/apps/extra-jars/hadoop-lzo-0.4.21-SNAPSHOT.jar
    fi

    exec java  $JAVA_HEAP_MAX $CLASS "$@"
    ;;

esac
